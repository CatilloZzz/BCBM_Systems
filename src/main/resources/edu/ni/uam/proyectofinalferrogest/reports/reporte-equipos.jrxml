<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="reporte_equipos_bcbm" pageWidth="842" pageHeight="595" columnWidth="774" leftMargin="34" rightMargin="34" topMargin="24" bottomMargin="24" whenNoDataType="AllSectionsNoDetail">
    <parameter name="CORTE" class="java.lang.String"/>
    <parameter name="PERIODO" class="java.lang.String"/>
    <parameter name="RESUMEN" class="java.lang.String"/>
    <parameter name="PLAN" class="java.lang.String"/>
    <field name="seccion" class="java.lang.String"/>
    <field name="equipo" class="java.lang.String"/>
    <field name="detalle" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="piezas" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <group name="Seccion" reprintHeaderOnEachPage="true">
        <expression><![CDATA[$F{seccion}]]></expression>
        <groupHeader><band height="25"><element kind="textField" x="0" y="3" width="774" height="21" mode="Opaque" backcolor="#F1F4F6" forecolor="#741B24" fontSize="11" bold="true"><expression><![CDATA[$F{seccion}]]></expression></element></band></groupHeader>
    </group>
    <title height="112">
        <element kind="staticText" x="0" y="0" width="774" height="26" fontSize="18" bold="true" forecolor="#9B1C2B"><text><![CDATA[BCBM · EQUIPOS Y MANTENIMIENTO]]></text></element>
        <element kind="textField" x="0" y="30" width="774" height="17" fontSize="10"><expression><![CDATA["Inventario al " + $P{CORTE} + " · Mantenimiento del " + $P{PERIODO}]]></expression></element>
        <element kind="textField" x="0" y="50" width="774" height="18" fontSize="10" bold="true"><expression><![CDATA[$P{RESUMEN}]]></expression></element>
        <element kind="textField" x="0" y="70" width="774" height="16" fontSize="9"><expression><![CDATA[$P{PLAN}]]></expression></element>
        <element kind="staticText" x="0" y="88" width="774" height="20" fontSize="8" forecolor="#546470"><text><![CDATA[Disponibles = piezas operativas sin asignar. El plan usa la última revisión de cada equipo e incluye vencidos anteriores al período.]]></text></element>
    </title>
    <columnHeader height="26">
        <element kind="staticText" x="0" y="0" width="180" height="26" mode="Opaque" backcolor="#741B24" forecolor="#FFFFFF" fontSize="10" bold="true" vTextAlign="Middle"><text><![CDATA[Equipo]]></text></element>
        <element kind="staticText" x="180" y="0" width="290" height="26" mode="Opaque" backcolor="#741B24" forecolor="#FFFFFF" fontSize="10" bold="true" vTextAlign="Middle"><text><![CDATA[Categoría / detalle]]></text></element>
        <element kind="staticText" x="470" y="0" width="100" height="26" mode="Opaque" backcolor="#741B24" forecolor="#FFFFFF" fontSize="10" bold="true" vTextAlign="Middle"><text><![CDATA[Estado]]></text></element>
        <element kind="staticText" x="570" y="0" width="120" height="26" mode="Opaque" backcolor="#741B24" forecolor="#FFFFFF" fontSize="10" bold="true" vTextAlign="Middle"><text><![CDATA[Piezas]]></text></element>
        <element kind="staticText" x="690" y="0" width="84" height="26" mode="Opaque" backcolor="#741B24" forecolor="#FFFFFF" fontSize="10" bold="true" vTextAlign="Middle"><text><![CDATA[Fecha]]></text></element>
    </columnHeader>
    <detail><band height="48" splitType="Stretch">
        <element kind="textField" x="0" y="3" width="172" height="42" fontSize="9" textAdjust="StretchHeight"><expression><![CDATA[$F{equipo}]]></expression></element>
        <element kind="textField" x="180" y="3" width="282" height="42" fontSize="9" textAdjust="StretchHeight"><expression><![CDATA[$F{detalle}]]></expression></element>
        <element kind="textField" x="470" y="3" width="92" height="42" fontSize="9" textAdjust="StretchHeight"><expression><![CDATA[$F{estado}]]></expression></element>
        <element kind="textField" x="570" y="3" width="112" height="42" fontSize="9" textAdjust="StretchHeight"><expression><![CDATA[$F{piezas}]]></expression></element>
        <element kind="textField" x="690" y="3" width="76" height="42" fontSize="9" textAdjust="StretchHeight"><expression><![CDATA[$F{fecha}]]></expression></element>
        <element kind="line" positionType="FixRelativeToBottom" x="0" y="47" width="774" height="1" forecolor="#E5E7EB"/>
    </band></detail>
    <pageFooter height="20">
        <element kind="staticText" x="0" y="3" width="600" height="16" fontSize="8" forecolor="#546470"><text><![CDATA[BCBM Systems · Inventario y mantenimiento · Los valores de inventario representan el corte de consulta.]]></text></element>
        <element kind="textField" x="690" y="3" width="84" height="16" fontSize="8" hTextAlign="Right"><expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression></element>
    </pageFooter>
</jasperReport>
