<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.ReportesCabinaController" styleClass="page" spacing="12">
    <Label text="Reportes mensuales de cabina" styleClass="page-title"/>
    <FlowPane hgap="9" vgap="6" alignment="CENTER_LEFT">
        <Button text="Mes anterior" onAction="#anterior"/><Label fx:id="periodo"/><Button text="Mes siguiente" onAction="#siguiente"/>
        <ComboBox fx:id="seccion"/><Button text="Actualizar" onAction="#cargar"/>
        <Button text="Exportar los tres reportes (CSV)" onAction="#exportar"/>
    </FlowPane>
    <Label fx:id="resumen" wrapText="true" styleClass="card-title"/>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS"><placeholder><Label text="Sin registros para este mes."/></placeholder>
        <columns>
            <TableColumn fx:id="grupo" text="Unidad, persona o emergencia" prefWidth="285"/>
            <TableColumn fx:id="tipo" text="Tipo de actividad" prefWidth="250"/>
            <TableColumn fx:id="cantidad" text="Cantidad por tipo" prefWidth="140"/>
            <TableColumn fx:id="total" text="Total del grupo" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
