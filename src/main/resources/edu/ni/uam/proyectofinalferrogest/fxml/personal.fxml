<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" styleClass="page" spacing="18" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.BomberoController" stylesheets="@../css/bcbm.css">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="5">
            <Label text="GESTIÓN INSTITUCIONAL" styleClass="eyebrow"/>
            <Label text="Personal" styleClass="page-title"/>
            <Label text="Fichas del personal, rangos y disponibilidad." styleClass="subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="cargando" prefWidth="22" prefHeight="22"/>
        <Button text="Actualizar" onAction="#cargar" styleClass="secondary"/>
    </HBox>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox styleClass="list-card" spacing="14" HBox.hgrow="ALWAYS" minWidth="350">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <TextField fx:id="buscar" promptText="Buscar por nombre, cédula o rango…" HBox.hgrow="ALWAYS" styleClass="search-field"/>
                <Label fx:id="contador" styleClass="count-label"/>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS" fixedCellSize="46">
                <placeholder>
                    <Label text="No hay registros para mostrar." styleClass="muted"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="195"/>
                    <TableColumn fx:id="colCedula" text="Cédula" prefWidth="150"/>
                    <TableColumn fx:id="colRango" text="Rango" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="135"/>
                </columns>
            </TableView>
            <Label text="Selecciona una fila para consultar sus datos." styleClass="footnote"/>
        </VBox>
        <VBox fx:id="formulario" styleClass="form-panel" minWidth="300" prefWidth="300" maxWidth="300">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" minHeight="0" prefHeight="0" VBox.vgrow="ALWAYS">
                <content>
                    <VBox styleClass="form-card" spacing="14">
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="tituloForm" text="Nuevo bombero" styleClass="card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Nuevo" onAction="#limpiar" styleClass="text-button"/>
                        </HBox>
                        <Label text="Los campos con * son obligatorios." styleClass="muted" wrapText="true"/>
                        <Separator/>
                        <VBox spacing="6">
                            <Label text="Nombre *" styleClass="field-label"/>
                            <TextField fx:id="nombre" promptText="Ej. Carlos"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Apellido *" styleClass="field-label"/>
                            <TextField fx:id="apellido" promptText="Ej. Mendoza"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Cédula *" styleClass="field-label"/>
                            <TextField fx:id="cedula" promptText="000-000000-0000A"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Rango *" styleClass="field-label"/>
                            <TextField fx:id="rango" promptText="Ej. Bombero"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Teléfono" styleClass="field-label"/>
                            <TextField fx:id="telefono" promptText="Opcional"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Fecha de ingreso *" styleClass="field-label"/>
                            <DatePicker fx:id="ingreso" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
            <VBox styleClass="form-actions" spacing="10">
                <Button text="Guardar cambios" onAction="#guardar" styleClass="primary" maxWidth="1.7976931348623157E308"/>
                <Separator/>
                <HBox spacing="8">
                    <Button fx:id="bajaButton" text="Dar de baja" onAction="#darBaja" styleClass="danger-outline" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                    <Button fx:id="reactivarButton" text="Reactivar" onAction="#reactivar" styleClass="secondary" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                </HBox>
                <Label text="Las bajas conservan el historial del bombero." styleClass="footnote" wrapText="true"/>
            </VBox>
        </VBox>
    </HBox>
    <Label fx:id="mensaje" styleClass="feedback" wrapText="true"/>
</VBox>
