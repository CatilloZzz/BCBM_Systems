  <TableColumn fx:id="aPrioridad" text="Prioridad" prefWidth="90"/>
  <TableColumn fx:id="aEstado" text="Estado" prefWidth="100"/>
  <TableColumn fx:id="aDireccion" text="Dirección" prefWidth="240"/>
  <TableColumn fx:id="aResultado" text="Resultado" prefWidth="140"/>
  <TableColumn fx:id="aCierre" text="Cierre" prefWidth="130"/>
 </columns></TableView></Tab>
 <Tab fx:id="porTipo" text="Por tipo"/>
 <Tab fx:id="porPrioridad" text="Por prioridad"/>
 <Tab fx:id="porEstado" text="Por estado"/>
 <Tab fx:id="porResultado" text="Por resultado"/>
</TabPane>
