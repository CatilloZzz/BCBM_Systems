<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="modulo" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.ni.uam.proyectofinalferrogest.controller.EmergenciasController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Emergencias" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label fx:id="aviso" text="Conecte la persistencia compartida y la sesión para usar el módulo."
           wrapText="true"/>
    <VBox fx:id="contenido" spacing="10" disable="true" VBox.vgrow="ALWAYS">
        <FlowPane hgap="10" vgap="8" alignment="BOTTOM_LEFT">
            <VBox spacing="4">
                <Label text="Estado"/>
                <ComboBox fx:id="estado" promptText="Todos" prefWidth="120"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Tipo"/>
                <ComboBox fx:id="tipo" promptText="Todos" prefWidth="160"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Desde"/>
                <DatePicker fx:id="desde" editable="false" prefWidth="130"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Hasta"/>
                <DatePicker fx:id="hasta" editable="false" prefWidth="130"/>
            </VBox>
            <Button text="Filtrar" onAction="#filtrar"/>
            <Button text="Limpiar" onAction="#limpiarFiltros"/>
        </FlowPane>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <placeholder><Label text="No hay emergencias para mostrar."/></placeholder>
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha de registro" prefWidth="150"/>
                <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="220"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130"/>
                <TableColumn fx:id="colPrioridad" text="Prioridad" prefWidth="90"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                <TableColumn fx:id="colUsuario" text="Registrada por" prefWidth="135"/>
            </columns>
        </TableView>
        <FlowPane hgap="8" vgap="8">
            <Button fx:id="nueva" text="Nueva emergencia" onAction="#registrar"/>
            <Button fx:id="detalle" text="Ver detalle" onAction="#verDetalle"/>
            <Button fx:id="editar" text="Editar" onAction="#editar"/>
            <Button fx:id="eliminar" text="Eliminar" onAction="#eliminar"/>
            <Button fx:id="cerrar" text="Cerrar emergencia" onAction="#cerrar"/>
            <Button text="Gestionar tipos" onAction="#gestionarTipos"/>
        </FlowPane>
    </VBox>
</VBox>
