<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" alignment="TOP_CENTER"
           styleClass="page-scroll, dashboard-viewport" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.InicioController"
           stylesheets="@../css/bcbm.css">
    <VBox styleClass="page dashboard-page" spacing="18" maxWidth="1500">
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-header">
            <VBox spacing="4">
                <Label text="CENTRO DE OPERACIONES" styleClass="eyebrow"/>
                <Label fx:id="saludo" text="Resumen institucional" styleClass="page-title"/>
                <Label fx:id="fechaResumen" styleClass="subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="cargando" prefWidth="22" prefHeight="22"/>
            <Button text="Actualizar" onAction="#actualizar" styleClass="secondary"/>
        </HBox>

        <VBox fx:id="panelPersonal" visible="false" managed="false" styleClass="personal-dashboard" spacing="10">
            <Label text="MI FICHA" styleClass="brand-eyebrow"/>
            <Label fx:id="nombreBombero" styleClass="welcome-title"/>
            <Label text="Estado actual" styleClass="brand-copy"/>
            <Label fx:id="estadoBombero" styleClass="personal-status"/>
            <Label text="La información institucional se mantiene reservada para los perfiles de administración y despacho."
                   styleClass="brand-copy" wrapText="true"/>
        </VBox>

        <VBox fx:id="panelInstitucional" spacing="18">
            <VBox styleClass="welcome-banner" spacing="8">
                <Label text="BOMBEROS DE MANAGUA" styleClass="brand-eyebrow"/>
                <Label text="Preparados para responder." styleClass="welcome-title"/>
                <Label text="Monitorea emergencias, disponibilidad y recursos desde un solo lugar."
                       styleClass="brand-copy" wrapText="true"/>
            </VBox>

            <GridPane hgap="14" vgap="14" styleClass="dashboard-grid">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.3333" minWidth="0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3333" minWidth="0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3334" minWidth="0" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="metric-card" spacing="7" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="EMERGENCIAS ACTIVAS" styleClass="metric-label" wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane styleClass="metric-icon metric-icon-red">
                            <SVGPath content="M12 2 C13 7 19 9 19 15 A7 7 0 0 1 5 15 C5 12 7 9 9 8 C9 11 11 12 12 12 C14 9 10 7 12 2 Z" styleClass="metric-glyph"/>
                        </StackPane>
                    </HBox>
                    <Label fx:id="emergenciasActivas" text="—" styleClass="metric-value"/>
                    <Label text="Pendientes y en proceso" styleClass="metric-note"/>
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="metric-card" spacing="7" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="REPORTADAS HOY" styleClass="metric-label" wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane styleClass="metric-icon metric-icon-gold">
                            <SVGPath content="M5 4 H19 V21 H5 Z M8 2 V7 M16 2 V7 M5 9 H19 M8 13 H10 M13 13 H16 M8 17 H10" styleClass="metric-glyph"/>
                        </StackPane>
                    </HBox>
                    <Label fx:id="emergenciasHoy" text="—" styleClass="metric-value"/>
                    <Label text="Nuevas actas del día" styleClass="metric-note"/>
                </VBox>
                <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="metric-card" spacing="7" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="UNIDADES DISPONIBLES" styleClass="metric-label" wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane styleClass="metric-icon metric-icon-green">
                            <SVGPath content="M2 6 H14 V17 H2 Z M14 10 H19 L22 14 V17 H14 M6 17 A2 2 0 1 0 6.01 17 M18 17 A2 2 0 1 0 18.01 17" styleClass="metric-glyph"/>
                        </StackPane>
                    </HBox>
                    <Label fx:id="unidadesDisponibles" text="—" styleClass="metric-value"/>
                    <Label fx:id="unidadesDetalle" text="de — registradas" styleClass="metric-note"/>
                </VBox>
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="metric-card" spacing="7" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="PERSONAL DISPONIBLE" styleClass="metric-label" wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane styleClass="metric-icon metric-icon-blue">
                            <SVGPath content="M12 3 A4 4 0 1 0 12.01 3 M4 21 V18 C4 12 20 12 20 18 V21" styleClass="metric-glyph"/>
                        </StackPane>
                    </HBox>
                    <Label fx:id="personalDisponible" text="—" styleClass="metric-value"/>
                    <Label fx:id="personalDetalle" text="de — activos" styleClass="metric-note"/>
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="metric-card" spacing="7" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="PIEZAS EN INVENTARIO" styleClass="metric-label" wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane styleClass="metric-icon metric-icon-blue">
                            <SVGPath content="M3 7 L12 3 L21 7 L12 11 Z M3 7 V17 L12 21 L21 17 V7 M12 11 V21" styleClass="metric-glyph"/>
                        </StackPane>
                    </HBox>
                    <Label fx:id="piezasInventario" text="—" styleClass="metric-value"/>
                    <Label text="Unidades físicas registradas" styleClass="metric-note"/>
                </VBox>
                <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="metric-card, metric-warning" spacing="7" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="PIEZAS EN REPARACIÓN" styleClass="metric-label" wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <StackPane styleClass="metric-icon metric-icon-gold">
                            <SVGPath content="M15 2 L12 5 L12 9 L9 12 L5 12 L2 15 L2 20 L7 22 L10 19 L10 15 L15 10 L19 10 L22 7 L22 2 L18 6 L15 5 Z" styleClass="metric-glyph"/>
                        </StackPane>
                    </HBox>
                    <Label fx:id="piezasReparacion" text="—" styleClass="metric-value"/>
                    <Label text="Requieren seguimiento" styleClass="metric-note"/>
                </VBox>
            </GridPane>

            <GridPane hgap="16" vgap="16" styleClass="dashboard-grid">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" minWidth="0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" minWidth="0" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="chart-panel" spacing="8" maxWidth="Infinity">
                    <Label text="Emergencias por día" styleClass="section-title"/>
                    <Label text="Actividad de los últimos siete días" styleClass="muted"/>
                    <LineChart fx:id="emergenciasChart" animated="false" createSymbols="true" legendVisible="false"
                               minHeight="250" prefHeight="270" VBox.vgrow="ALWAYS" styleClass="dashboard-chart">
                        <xAxis><CategoryAxis label="Día" animated="false"/></xAxis>
                        <yAxis><NumberAxis label="Emergencias" forceZeroInRange="true" animated="false"/></yAxis>
                    </LineChart>
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="chart-panel" spacing="8" maxWidth="Infinity">
                    <Label text="Disponibilidad de unidades" styleClass="section-title"/>
                    <Label text="Distribución según su estado actual" styleClass="muted"/>
                    <StackPane minHeight="270" prefHeight="270" VBox.vgrow="ALWAYS">
                        <PieChart fx:id="unidadesChart" animated="false" labelsVisible="true" legendVisible="true"
                                  styleClass="dashboard-chart"/>
                        <Label fx:id="sinUnidades" text="Aún no hay unidades registradas" styleClass="chart-empty"
                               visible="false" managed="false" wrapText="true"/>
                    </StackPane>
                </VBox>
            </GridPane>

            <GridPane hgap="16" vgap="16" styleClass="dashboard-grid">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" minWidth="0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" minWidth="0" hgrow="ALWAYS"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="320" prefHeight="320" vgrow="NEVER"/>
                </rowConstraints>
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="chart-panel, dashboard-list-panel" spacing="10" maxWidth="Infinity">
                    <VBox spacing="3">
                        <Label text="Emergencias recientes" styleClass="section-title"/>
                        <Label text="Últimas actas registradas" styleClass="muted"/>
                    </VBox>
                    <VBox fx:id="listaEmergencias" spacing="7" styleClass="dashboard-list" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="chart-panel, dashboard-list-panel" spacing="10" maxWidth="Infinity">
                    <VBox spacing="3">
                        <Label text="Mantenimientos próximos" styleClass="section-title"/>
                        <Label text="Programados para los próximos 30 días" styleClass="muted"/>
                    </VBox>
                    <VBox fx:id="listaMantenimientos" spacing="7" styleClass="dashboard-list" VBox.vgrow="ALWAYS"/>
                </VBox>
            </GridPane>

            <HBox styleClass="weather-strip" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="TIEMPO EN MANAGUA" styleClass="eyebrow"/>
                    <Label fx:id="clima" text="Consulta el estado del tiempo" styleClass="card-title" wrapText="true"/>
                    <Label fx:id="estadoClima" styleClass="muted" wrapText="true"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <ProgressIndicator fx:id="cargandoClima" visible="false" managed="false" prefWidth="20" prefHeight="20"/>
                <Button fx:id="consultarClima" text="Actualizar clima" onAction="#actualizarClima" styleClass="secondary"/>
            </HBox>

            <Label text="Accesos rápidos" styleClass="section-title"/>
            <GridPane hgap="14" vgap="14" styleClass="dashboard-grid">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.3333" minWidth="0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3333" minWidth="0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3334" minWidth="0" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="quick-card" spacing="8" maxWidth="Infinity">
                    <Label text="Personal" styleClass="card-title"/>
                    <Label text="Fichas, rangos y disponibilidad." styleClass="muted" wrapText="true" VBox.vgrow="ALWAYS"/>
                    <Button text="Ver personal  →" onAction="#verPersonal" styleClass="text-button"/>
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="quick-card" spacing="8" maxWidth="Infinity">
                    <Label text="Equipos" styleClass="card-title"/>
                    <Label text="Inventario y dotación por unidad." styleClass="muted" wrapText="true" VBox.vgrow="ALWAYS"/>
                    <Button text="Ver equipos  →" onAction="#verEquipos" styleClass="text-button"/>
                </VBox>
                <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="quick-card" spacing="8" maxWidth="Infinity">
                    <Label text="Mantenimiento" styleClass="card-title"/>
                    <Label text="Trabajos y próximas fechas." styleClass="muted" wrapText="true" VBox.vgrow="ALWAYS"/>
                    <Button text="Ver historial  →" onAction="#verMantenimiento" styleClass="text-button"/>
                </VBox>
            </GridPane>
            <Label text="Los datos del panel dependen de los permisos de tu cuenta." styleClass="footnote" wrapText="true"/>
        </VBox>
    </VBox>
</StackPane>
