<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" styleClass="page" spacing="18" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.EquipoController" stylesheets="@../css/bcbm.css">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="5">
            <Label text="GESTIÓN INSTITUCIONAL" styleClass="eyebrow"/>
            <Label text="Inventario de equipos" styleClass="page-title"/>
            <Label text="Controla las existencias, su estado y la unidad asignada." styleClass="subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="cargando" prefWidth="22" prefHeight="22"/>
        <Button text="Actualizar" onAction="#cargar" styleClass="secondary"/>
    </HBox>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox styleClass="list-card" spacing="14" HBox.hgrow="ALWAYS" minWidth="350">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <TextField fx:id="buscar" promptText="Buscar equipo, categoría o unidad…" HBox.hgrow="ALWAYS" styleClass="search-field"/>
                <Label fx:id="contador" styleClass="count-label"/>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS" fixedCellSize="46">
                <placeholder>
                    <Label text="No hay registros para mostrar." styleClass="muted"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colNombre" text="Equipo" prefWidth="190"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="105"/>
                    <TableColumn fx:id="colCantidad" text="Cant." prefWidth="65"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="125"/>
                    <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="85"/>
                    <TableColumn fx:id="colMantenimiento" text="Últ. mant." prefWidth="115"/>
                </columns>
            </TableView>
            <Label text="Selecciona una fila para consultar sus datos." styleClass="footnote"/>
        </VBox>
        <VBox fx:id="formulario" styleClass="form-panel" minWidth="300" prefWidth="300" maxWidth="300">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" minHeight="0" prefHeight="0" VBox.vgrow="ALWAYS">
                <content>
                    <VBox styleClass="form-card" spacing="14">
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="tituloForm" text="Nuevo equipo" styleClass="card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Nuevo" onAction="#limpiar" styleClass="text-button"/>
                        </HBox>
                        <Label text="Cada registro representa un equipo o grupo de piezas. Los campos con * son obligatorios." styleClass="muted" wrapText="true"/>
                        <Separator/>
                        <VBox spacing="6">
                            <Label text="Nombre del equipo *" styleClass="field-label"/>
                            <TextField fx:id="nombre" promptText="Ej. Casco de bombero"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Categoría *" styleClass="field-label"/>
                            <TextField fx:id="categoria" promptText="Ej. Protección"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Cantidad *" styleClass="field-label"/>
                            <TextField fx:id="cantidad" promptText="Número de piezas"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Estado *" styleClass="field-label"/>
                            <ComboBox fx:id="estado" promptText="" maxWidth="1.7976931348623157E308"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Unidad asignada" styleClass="field-label"/>
                            <ComboBox fx:id="unidad" promptText="Sin unidad" maxWidth="1.7976931348623157E308"/>
                            <Button text="Quitar unidad" onAction="#quitarUnidad" styleClass="text-button"/>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
            <VBox styleClass="form-actions" spacing="10">
                <Button text="Guardar cambios" onAction="#guardar" styleClass="primary" maxWidth="1.7976931348623157E308"/>
                <Label text="Para dar de baja un equipo, selecciona el estado De baja y guarda." styleClass="footnote" wrapText="true"/>
            </VBox>
        </VBox>
    </HBox>
    <Label fx:id="mensaje" styleClass="feedback" wrapText="true"/>
</VBox>
