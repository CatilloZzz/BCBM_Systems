<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.DespachoController" spacing="16" styleClass="page" stylesheets="@../css/bcbm.css">
    <FlowPane alignment="CENTER_LEFT" hgap="20" vgap="10" styleClass="page-header">
        <VBox spacing="5">
                        <Label fx:id="titulo" styleClass="page-title"/>
            <Label fx:id="subtitulo" styleClass="subtitle" wrapText="true"/>
        </VBox>

        <ProgressIndicator fx:id="cargando" prefWidth="22" prefHeight="22"/>
        <Button fx:id="crearSalida" text="Despachar unidad" onAction="#nueva" styleClass="primary"/>
    </FlowPane>

    <FlowPane hgap="12" vgap="8" alignment="CENTER_LEFT">
        <Label text="Mes"/><ComboBox fx:id="mes" prefWidth="85"/>
        <Label text="Año"/><Spinner fx:id="anio" prefWidth="100"/>
        <CheckBox fx:id="activas" text="Unidades fuera (todos los meses)"/>
        <Button text="Consultar / Actualizar" onAction="#actualizar" styleClass="secondary"/>
        <TextField fx:id="buscar" promptText="Buscar unidad, personal o actividad…" prefWidth="245"/>
        <Label fx:id="contador" styleClass="count-label"/>
    </FlowPane>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" fixedCellSize="44">
        <placeholder><Label text="No hay salidas para esta consulta."/></placeholder>
        <columns>
            <TableColumn fx:id="colEstado"    text="Estado"               prefWidth="100"/>
            <TableColumn fx:id="colActividad" text="Actividad"            prefWidth="130"/>
            <TableColumn fx:id="colEscuadra"  text="Escuadra / Departamento" prefWidth="160"/>
            <TableColumn fx:id="colUnidad"    text="Unidad"               prefWidth="90"/>
            <TableColumn fx:id="colOperador"  text="Operador"             prefWidth="150"/>
            <TableColumn fx:id="colJefe"      text="Jefe de unidad"       prefWidth="150"/>
            <TableColumn fx:id="colPersonal"  text="Participantes"        prefWidth="220"/>
            <TableColumn fx:id="colSalida"    text="Sale"                 prefWidth="145"/>
            <TableColumn fx:id="colLlegada"   text="Llega"                prefWidth="145"/>
            <TableColumn fx:id="colRetorno"   text="Retorna"              prefWidth="145"/>
            <TableColumn fx:id="colTipo"      text="Tipo de gestión"      prefWidth="180"/>
            <TableColumn fx:id="colDetalle"   text="Detalle / Dirección"  prefWidth="260"/>
        </columns>
    </TableView>

    <FlowPane fx:id="detalle" hgap="16" vgap="12" styleClass="list-card" managed="false" visible="false" alignment="CENTER_LEFT">
        <VBox spacing="4" prefWidth="460">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="detalleUnidad" styleClass="card-title"/>
                <Label fx:id="detalleEstado" styleClass="status-badge"/>
            </HBox>
            <Label fx:id="detalleTripulacion" styleClass="muted" wrapText="true"/>
            <Label fx:id="detalleSalida" styleClass="footnote"/>
        </VBox>
        <VBox spacing="6" alignment="CENTER_RIGHT" minWidth="200">
            <Button fx:id="llegada"  text="Registrar llegada" onAction="#marcarLlegada" styleClass="secondary"/>
            <Button fx:id="retorno"  text="Registrar retorno" onAction="#registrarRetorno" styleClass="primary"/>
        </VBox>
    </FlowPane>

    <Label fx:id="mensaje" styleClass="feedback" wrapText="true"/>
</VBox>
