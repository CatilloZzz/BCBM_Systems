<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" styleClass="app-shell" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.MenuController" stylesheets="@../css/bcbm.css">
    <left>
        <ScrollPane fx:id="navegacion" styleClass="nav-scroll" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" prefWidth="248" minWidth="215"><content>
        <VBox styleClass="sidebar" spacing="8">
            <VBox styleClass="sidebar-brand" alignment="CENTER" spacing="12">
                <StackPane styleClass="logo-tile" minWidth="96" prefWidth="96" maxWidth="96" minHeight="96" maxHeight="96">
                    <ImageView fitWidth="82" fitHeight="82" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/logo-bcbm.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <Label text="BCBM SYSTEMS" styleClass="sidebar-title"/>
                <Label text="Bomberos de Managua" styleClass="sidebar-subtitle"/>
            </VBox>
            <Separator styleClass="sidebar-divider"/>
            <Label text="ESPACIO DE TRABAJO" styleClass="nav-section"/>
            <Button fx:id="inicioButton" text="Inicio" onAction="#inicio" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M3 10 L12 3 L21 10 M5 9 V21 H10 V15 H14 V21 H19 V9" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="emergenciasButton" text="Emergencias" onAction="#emergencias" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M12 3 C13 7 19 9 19 15 A7 7 0 0 1 5 15 C5 12 7 9 9 8 C9 11 11 12 12 12 C14 9 10 7 12 3 Z" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="despachoButton" text="Despacho y movimientos" onAction="#despacho" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M4 6 H14 M10 2 L14 6 L10 10 M20 18 H10 M14 14 L10 18 L14 22 M4 12 V18 H7 M20 12 V6 H17" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="serviciosButton" text="Otros servicios" onAction="#servicios" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M4 7 H20 V21 H4 Z M9 7 V3 H15 V7 M4 12 H20 M10 12 V15 H14 V12" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="unidadesButton" text="Unidades y dotación" onAction="#unidades" styleClass="nav-button" maxWidth="Infinity">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M2 6 H14 V18 H2 Z M14 10 H19 L22 14 V18 H14 M6 18 A2 2 0 1 0 6.01 18 M18 18 A2 2 0 1 0 18.01 18" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="reportesButton" text="Reportes de cabina" onAction="#reportes" styleClass="nav-button" maxWidth="Infinity">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M5 3 H15 L20 8 V21 H5 Z M14 3 V9 H20 M9 17 V14 M12 17 V11 M15 17 V13" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="personalButton" text="Personal" onAction="#personal" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M12 3 A4 4 0 1 0 12.01 3 M4 21 V18 C4 12 20 12 20 18 V21" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="equiposButton" text="Equipos" onAction="#equipos" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M3 7 H21 V21 H3 Z M3 7 L7 3 H17 L21 7 M3 11 H21 M9 15 H15" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="mantenimientoButton" text="Mantenimiento" onAction="#mantenimiento" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M21 3 L16 8 L13 5 L18 1 C12 0 9 4 10 9 L2 17 A3 3 0 0 0 7 22 L15 14 C20 15 24 10 21 3 Z" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="usuariosButton" text="Usuarios" onAction="#usuarios" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M12 2 L21 6 V12 C21 17 17 20 12 23 C7 20 3 17 3 12 V6 Z M8 12 L11 15 L17 9" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Button fx:id="configuracionButton" text="Configuración" onAction="#configuracion" styleClass="nav-button" maxWidth="Infinity">
                <graphic>
                    <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                        <SVGPath content="M4 6 H9 M15 6 H20 M4 12 H15 M21 12 H20 M4 18 H5 M11 18 H20 M12 3 A3 3 0 1 0 12.01 3 M18 9 A3 3 0 1 0 18.01 9 M8 15 A3 3 0 1 0 8.01 15" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/>
                    </StackPane>
                </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="session-block" spacing="5">
                <Label text="SESIÓN ACTIVA" styleClass="nav-section"/>
                <Label fx:id="usuario" styleClass="session-name"/>
                <Label fx:id="rol" styleClass="sidebar-subtitle"/>
            </VBox>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="logout-button" maxWidth="Infinity">
                <graphic><StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22"><SVGPath content="M9 3 H3 V21 H9 M14 7 L19 12 L14 17 M8 12 H19" styleClass="nav-icon" scaleX="0.78" scaleY="0.78"/></StackPane></graphic>
            </Button>
            <Label text="MANAGUA · NICARAGUA" styleClass="sidebar-footer"/>
        </VBox>
        </content></ScrollPane>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="menuButton" text="Ocultar menú" onAction="#alternarMenu" styleClass="secondary"/>
                    <Label text="BCBM" styleClass="topbar-brand"/>
                    <Label text="/" styleClass="muted"/>
                    <Label fx:id="seccion" styleClass="topbar-section"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="fecha" styleClass="muted"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contenido" minWidth="0"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
