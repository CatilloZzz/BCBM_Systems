<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:id="root" styleClass="app-shell" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.MenuController" stylesheets="@../css/bcbm.css">
    <left>
        <VBox styleClass="sidebar" minWidth="232" prefWidth="232" maxWidth="232" spacing="8">
            <VBox styleClass="sidebar-brand" alignment="CENTER" spacing="12">
                <StackPane styleClass="logo-tile" minWidth="96" prefWidth="96" maxWidth="96" minHeight="96" maxHeight="96">
                    <ImageView fitWidth="82" fitHeight="82" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/logo-bcbm.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <Label text="BCBM SYSTEMS" styleClass="sidebar-title"/>
                <Label text="Bomberos de Managua" styleClass="sidebar-subtitle"/>
            </VBox>
            <Separator styleClass="sidebar-divider"/>
            <Label text="ESPACIO DE TRABAJO" styleClass="nav-section"/>
            <Button fx:id="inicioButton" text="Inicio" onAction="#inicio" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <SVGPath content="M2 10 L12 2 L22 10 L20 12 L20 22 L14 22 L14 15 L10 15 L10 22 L4 22 L4 12 Z" styleClass="nav-icon" scaleX="0.74" scaleY="0.74"/>
                </graphic>
            </Button>
            <Button fx:id="emergenciasButton" text="Emergencias" onAction="#emergencias" styleClass="nav-button" maxWidth="1.7976931348623157E308"/>
            <Button fx:id="personalButton" text="Personal" onAction="#personal" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <SVGPath content="M12 2 A5 5 0 1 1 11.99 2 Z M3 22 L3 19 C3 10 21 10 21 19 L21 22 Z" styleClass="nav-icon" scaleX="0.74" scaleY="0.74"/>
                </graphic>
            </Button>
            <Button fx:id="equiposButton" text="Equipos" onAction="#equipos" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <SVGPath content="M3 4 L21 4 L21 8 L3 8 Z M5 10 L19 10 L19 22 L5 22 Z M9 12 L9 14 L15 14 L15 12 Z" styleClass="nav-icon" scaleX="0.74" scaleY="0.74"/>
                </graphic>
            </Button>
            <Button fx:id="mantenimientoButton" text="Mantenimiento" onAction="#mantenimiento" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <SVGPath content="M15 2 L12 5 L12 9 L9 12 L5 12 L2 15 L2 20 L7 22 L10 19 L10 15 L15 10 L19 10 L22 7 L22 2 L18 6 L15 5 Z" styleClass="nav-icon" scaleX="0.74" scaleY="0.74"/>
                </graphic>
            </Button>
            <Button fx:id="usuariosButton" text="Usuarios" onAction="#usuarios" styleClass="nav-button" maxWidth="1.7976931348623157E308">
                <graphic>
                    <SVGPath content="M12 1 L22 5 L21 14 Q19 20 12 23 Q5 20 3 14 L2 5 Z M10 14 L8 12 L6 14 L10 18 L18 10 L16 8 Z" styleClass="nav-icon" scaleX="0.74" scaleY="0.74"/>
                </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="session-block" spacing="5">
                <Label text="SESIÓN ACTIVA" styleClass="nav-section"/>
                <Label fx:id="usuario" styleClass="session-name"/>
                <Label fx:id="rol" styleClass="sidebar-subtitle"/>
            </VBox>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="logout-button" maxWidth="1.7976931348623157E308"/>
            <Label text="MANAGUA · NICARAGUA" styleClass="sidebar-footer"/>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
                    <Label text="BCBM" styleClass="topbar-brand"/>
                    <Label text="/" styleClass="muted"/>
                    <Label fx:id="seccion" styleClass="topbar-section"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="fecha" styleClass="muted"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contenido"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
