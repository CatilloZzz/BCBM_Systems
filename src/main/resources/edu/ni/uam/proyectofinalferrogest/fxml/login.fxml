<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" styleClass="login-root" stylesheets="@../css/bcbm.css" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.LoginController">
    <VBox fx:id="marca" alignment="CENTER" minWidth="340" prefWidth="360" maxWidth="400" spacing="24" styleClass="login-brand">
        <VBox alignment="CENTER" spacing="24" maxWidth="290">
            <StackPane styleClass="logo-tile" minWidth="176" prefWidth="176" maxWidth="176" minHeight="176" prefHeight="176" maxHeight="176">
                <ImageView fitWidth="152" fitHeight="152" preserveRatio="true" smooth="true">
                    <image><Image url="@../images/logo-bcbm.png"/></image>
                </ImageView>
            </StackPane>
            <VBox alignment="CENTER" spacing="10">
                <Label text="Benemérito Cuerpo&#10;de Bomberos de Managua" styleClass="login-institution" textAlignment="CENTER" wrapText="true"/>
                <Region styleClass="gold-rule" minWidth="48" maxWidth="48" minHeight="3" maxHeight="3"/>
                <Label text="Al servicio de Managua" styleClass="brand-copy" textAlignment="CENTER"/>
            </VBox>
            <Label text="HONOR · DISCIPLINA · ABNEGACIÓN" styleClass="brand-motto" textAlignment="CENTER"/>
        </VBox>
    </VBox>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" minWidth="0" HBox.hgrow="ALWAYS" styleClass="login-scroll">
        <StackPane minWidth="0" styleClass="login-content">
            <VBox alignment="CENTER_LEFT" maxWidth="410" minHeight="-Infinity" spacing="18">
                <StackPane fx:id="logoCompacto" visible="false" managed="false">
                    <ImageView fitWidth="76" fitHeight="76" preserveRatio="true" smooth="true">
                        <image><Image url="@../images/logo-bcbm.png"/></image>
                    </ImageView>
                </StackPane>
                <Label text="BCBM / ACCESO INSTITUCIONAL" styleClass="eyebrow"/>
                <VBox spacing="8">
                    <Label text="Bienvenido de nuevo" styleClass="login-heading" wrapText="true"/>
                    <Label text="Ingresa a tu espacio de trabajo." styleClass="subtitle"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Usuario" styleClass="field-label"/>
                    <TextField fx:id="usuario" onAction="#acceder" promptText="Escribe tu usuario" styleClass="login-input"/>
                </VBox>
                <VBox spacing="8">
                    <Label text="Contraseña" styleClass="field-label"/>
                    <PasswordField fx:id="clave" onAction="#acceder" promptText="Escribe tu contraseña" styleClass="login-input"/>
                </VBox>
                <Label fx:id="error" maxWidth="Infinity" styleClass="inline-error" wrapText="true"/>
                <Button text="Iniciar sesión" onAction="#acceder" defaultButton="true" styleClass="primary, login-submit" maxWidth="Infinity"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ProgressIndicator fx:id="cargando" prefWidth="20" prefHeight="20"/>
                    <Label text="Usa la cuenta asignada por tu administrador." styleClass="muted" wrapText="true"/>
                </HBox>
                <Separator/>
                <TitledPane text="Configuración inicial" expanded="false" animated="false" styleClass="setup-pane">
                    <VBox spacing="10">
                        <Label text="Solo si todavía no existen usuarios en el sistema." styleClass="muted" wrapText="true"/>
                        <Button text="Crear primer administrador" onAction="#primerAdmin" styleClass="secondary"/>
                    </VBox>
                </TitledPane>
            </VBox>
        </StackPane>
    </ScrollPane>
</HBox>
