<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox fx:id="root" styleClass="login-root" stylesheets="@../css/bcbm.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="edu.ni.uam.proyectofinalferrogest.controller.LoginController">
    <VBox fx:id="marca" maxWidth="540" minWidth="414.0" prefHeight="640.0" prefWidth="414.0" spacing="24" styleClass="login-brand" HBox.hgrow="ALWAYS">
        <Label styleClass="brand-eyebrow" text="BENEMÉRITO CUERPO DE BOMBEROS" wrapText="true" />
        <Region VBox.vgrow="ALWAYS" />
        <StackPane maxWidth="184" minHeight="184" prefHeight="184" styleClass="logo-tile">
            <ImageView fitHeight="160" fitWidth="160" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/logo-bcbm.png" />
                </image>
            </ImageView>
        </StackPane>
        <VBox spacing="10">
            <Label styleClass="login-title" text="Al servicio de&#10;Managua." />
            <Region maxWidth="62" minHeight="4" prefHeight="4" styleClass="gold-rule" />
            <Label styleClass="brand-copy" text="Personas, equipos y compromiso&#10;al servicio de nuestra comunidad." wrapText="true" />
        </VBox>
        <Region VBox.vgrow="ALWAYS" />
        <VBox spacing="8">
            <Label styleClass="brand-motto" text="HONOR · DISCIPLINA · ABNEGACIÓN" />
            <Label styleClass="brand-caption" text="MANAGUA, NICARAGUA" />
        </VBox>
    </VBox>
    <StackPane minWidth="0" styleClass="login-content" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER_LEFT" maxWidth="410" spacing="18">
            <Label styleClass="eyebrow" text="BCBM / ACCESO INSTITUCIONAL" />
            <VBox spacing="8">
                <Label styleClass="login-heading" text="Bienvenido de nuevo" />
                <Label styleClass="subtitle" text="Ingresa a tu espacio de trabajo." />
            </VBox>
            <Region minHeight="12" />
            <VBox spacing="8">
                <Label styleClass="field-label" text="Usuario" />
                <TextField fx:id="usuario" onAction="#acceder" promptText="Escribe tu usuario" styleClass="login-input" />
            </VBox>
            <VBox spacing="8">
                <Label styleClass="field-label" text="Contraseña" />
                <PasswordField fx:id="clave" onAction="#acceder" promptText="Escribe tu contraseña" styleClass="login-input" />
            </VBox>
            <Label fx:id="error" maxWidth="1.7976931348623157E308" styleClass="inline-error" wrapText="true" />
            <Button defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#acceder" styleClass="primary, login-submit" text="Iniciar sesión" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ProgressIndicator fx:id="cargando" prefHeight="20" prefWidth="20" />
                <Label styleClass="muted" text="Usa la cuenta asignada por tu administrador." wrapText="true" />
            </HBox>
            <Separator />
            <TitledPane animated="false" expanded="false" styleClass="setup-pane" text="Configuración inicial">
                <VBox spacing="10">
                    <Label styleClass="muted" text="Solo si todavía no existen usuarios en el sistema." wrapText="true" />
                    <Button onAction="#primerAdmin" styleClass="secondary" text="Crear primer administrador" />
                </VBox>
            </TitledPane>
        </VBox>
    </StackPane>
</HBox>
